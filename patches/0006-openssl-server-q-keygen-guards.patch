From: Roman Senn <roman.l.senn@gmail.com>
Subject: [PATCH] openssl-server: guard RSA paths for EVP_PKEY_Q_keygen builds

lws_tls_acme_sni_cert_create() referenced vhost->tls.ss->rsa, a field
that struct lws_tls_ss_pieces only has when LWS_HAVE_EVP_PKEY_Q_KEYGEN is
*not* defined, so it failed to compile against modern OpenSSL. Generate
the key straight into ->pkey in that case and compile out the bail2
RSA_free cleanup.

Also move the bail0 label in lws_tls_acme_sni_csr_create_ecdsa() inside
the #if that uses it, which silences -Wunused-label.

Made against libwebsockets 222ccba9f (main).

---
diff --git a/lib/tls/openssl/openssl-server.c b/lib/tls/openssl/openssl-server.c
index 3b15ffdd0..585722abf 100644
--- a/lib/tls/openssl/openssl-server.c
+++ b/lib/tls/openssl/openssl-server.c
@@ -1088,6 +1088,10 @@ lws_tls_acme_sni_cert_create(struct lws_vhost *vhost, const char *san_a,
 	X509_gmtime_adj(X509_get_notBefore(vhost->tls.ss->x509), 0);
 	X509_gmtime_adj(X509_get_notAfter(vhost->tls.ss->x509), 3600);
 
+#if defined(LWS_HAVE_EVP_PKEY_Q_KEYGEN)
+	if (lws_tls_openssl_rsa_new_key(&vhost->tls.ss->pkey, 4096))
+		goto bail0;
+#else
 	vhost->tls.ss->pkey = EVP_PKEY_new();
 	if (!vhost->tls.ss->pkey)
 		goto bail0;
@@ -1097,6 +1101,7 @@ lws_tls_acme_sni_cert_create(struct lws_vhost *vhost, const char *san_a,
 
 	if (!EVP_PKEY_assign_RSA(vhost->tls.ss->pkey, vhost->tls.ss->rsa))
 		goto bail2;
+#endif
 
 	/*
 	 * From here the EVP_PKEY owns the RSA key, so any failure must unwind
@@ -1187,8 +1192,10 @@ lws_tls_acme_sni_cert_create(struct lws_vhost *vhost, const char *san_a,
 
 	return 0;
 
+#if !defined(LWS_HAVE_EVP_PKEY_Q_KEYGEN)
 bail2:
 	RSA_free(vhost->tls.ss->rsa);
+#endif
 bail1:
 	EVP_PKEY_free(vhost->tls.ss->pkey);
 bail0:
@@ -1585,12 +1592,12 @@ bail2:
 bail1:
 	EVP_PKEY_free(pkey);
 	return ret;
-bail0:
 #if !defined(LWS_HAVE_EVP_PKEY_Q_KEYGEN)
+bail0:
 	if (eckey)
 		EC_KEY_free(eckey);
-#endif
 	return -1;
 #endif
+#endif
 }
 #endif
