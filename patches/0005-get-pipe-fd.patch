+/*
+ * Not in any public header: the read end of tsi's event pipe, so an external
+ * event loop (qjs-lws) can poll it itself.  -1 if there is none.
+ */
+int
+lws_context_get_pipe_fd(struct lws_context *context, int tsi)
+{
+	struct lws *wsi;
+
+	if (tsi < 0 || tsi >= (int)context->count_threads)
+		return -1;
+
+	wsi = context->pt[tsi].pipe_wsi;
+	if (!wsi || !wsi->io || wsi->io->desc.sockfd == LWS_SOCK_INVALID)
+		return -1;
+
+	return (int)wsi->io->desc.sockfd;
+}
